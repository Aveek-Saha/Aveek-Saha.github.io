---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { site } from '../../data/site';
import { getProjects, projectDescription, projectPath, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previous: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
    },
  }));
}

interface Props {
  project: Project;
  previous: Project | null;
  next: Project | null;
}

const { project, previous, next } = Astro.props;
const description = projectDescription(project);
const plainDescription = description.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() || site.role;
---

<BaseLayout title={`${project.data.title} — Aveek Saha`} description={plainDescription}>
  <article class="shell project-page">
    <header class="project-header">
      <a href="/#projects">← Projects</a>
    </header>
    <section class="project-title">
      <div class="title-copy">
        <p class="eyebrow">{project.data.category}</p>
        <h1>{project.data.title}</h1>
        <time datetime={project.data.date.toISOString()}>{project.data['project-date']}</time>
        {(project.data.github || project.data.website) && (
          <div class="project-actions">
            {project.data.website && <a class="button" href={project.data.website} target="_blank" rel="noreferrer">Website <span aria-hidden="true">↗</span></a>}
            {project.data.github && <a class:list={['button', project.data.website && 'secondary']} href={project.data.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>}
          </div>
        )}
      </div>
      <figure>
        <img src={`/img/portfolio/${project.data.img}`} alt={project.data.alt ?? ''} />
      </figure>
    </section>
    {description && <section class="project-description" set:html={description} />}
    <nav class="project-nav" aria-label="Projects">
      <div>{previous && <><span>Previous</span><a href={projectPath(previous)}>{previous.data.title}</a></>}</div>
      <div>{next && <><span>Next</span><a href={projectPath(next)}>{next.data.title}</a></>}</div>
    </nav>
    <SiteFooter />
  </article>
</BaseLayout>

<style>
  .project-page { padding-top: 62px; }
  .project-header { display: flex; min-height: 64px; align-items: center; justify-content: space-between; padding: 0 72px; border-bottom: 1px solid var(--border); color: var(--weak); font-size: 11px; }
  .project-title { display: grid; grid-template-columns: minmax(0, 1fr) 132px; align-items: center; gap: 48px; padding: 88px 72px 72px; border-bottom: 1px solid var(--border); }
  .project-title h1 { max-width: 820px; margin: 0 0 22px; color: var(--fg); font: 650 clamp(50px, 8vw, 88px)/.98 var(--sans); letter-spacing: -.065em; }
  .project-title time { color: var(--weak); font-size: 11px; }
  .project-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  figure { display: grid; width: 132px; aspect-ratio: 1; margin: 0; place-items: center; border: 1px solid var(--border); background: var(--surface); }
  figure img { width: 84px; height: 84px; object-fit: contain; }
  figure img[src$='wordle.png'] { filter: invert(1); }
  .project-description { max-width: 720px; padding: 72px; color: var(--fg); font: 18px/1.78 var(--sans); }
  .project-description :global(div) { margin-top: 40px; color: var(--weak); font: 11px/1.6 var(--mono); }
  .project-description :global(a) { overflow-wrap: anywhere; }
  .project-nav { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--border); }
  .project-nav div { min-height: 130px; padding: 32px 72px; }
  .project-nav div + div { border-left: 1px solid var(--border); text-align: right; }
  .project-nav span, .project-nav a { display: block; }
  .project-nav span { margin-bottom: 8px; color: var(--weak); font-size: 10px; text-transform: uppercase; }
  .project-nav a { font: 600 18px var(--sans); }
  @media (max-width: 800px) {
    .project-page { padding-top: 58px; }
    .project-header { padding-inline: 24px; }
    .project-title { grid-template-columns: minmax(0, 1fr) 76px; gap: 18px; padding: 56px 24px; }
    .project-title h1 { font-size: clamp(38px, 11vw, 64px); }
    .project-description { padding: 56px 24px; }
    figure { width: 76px; }
    figure img { width: 50px; height: 50px; }
    .project-nav { grid-template-columns: 1fr; }
    .project-nav div { min-height: 100px; padding: 26px 24px; }
    .project-nav div + div { border-top: 1px solid var(--border); border-left: 0; }
  }
</style>
