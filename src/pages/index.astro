---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ParticleField from '../components/ParticleField.astro';
import ProjectArchiveLink from '../components/ProjectArchiveLink.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TechStack from '../components/TechStack.astro';
import { site } from '../data/site';
import { getProjects, projectPath } from '../lib/projects';

const projects = await getProjects();
const featuredProjects = projects.slice(0, 10);
---

<BaseLayout title="Aveek Saha" description={site.role} headerNameTarget="home-title">
  <div class="shell home">
    <ParticleField>
      <section class="hero" aria-labelledby="home-title">
        <div class="hero-copy">
          <h1 class="display" id="home-title">Aveek<br />Saha.</h1>
          <p class="intro">{site.role}</p>
          <div class="actions">
            <a class="button" href="#projects">Projects <span aria-hidden="true">↓</span></a>
            <a class="button secondary" href="mailto:aveek.s98@gmail.com">Contact Me</a>
          </div>
        </div>
      </section>
    </ParticleField>

    <section class="statement section" id="about" aria-labelledby="about-title">
      <h2 class="eyebrow" id="about-title">Who am I?</h2>
      <p>{site.about}</p>
    </section>

    <ExperienceSection />

    <section class="projects" id="projects" aria-labelledby="projects-title">
      <header><h2 class="section-title" id="projects-title">Projects</h2></header>
      <ul class="project-grid">
        {featuredProjects.map((project) => (
          <li>
            <a href={projectPath(project)} aria-label={`${project.data.title} project details`}>
              <img src={`/img/portfolio/${project.data.img}`} alt="" loading="lazy" />
              <strong>{project.data.title}</strong>
            </a>
          </li>
        ))}
      </ul>
      <ProjectArchiveLink />
    </section>

    <TechStack heading="Stack" />
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .hero { display: flex; min-height: 100svh; flex-direction: column; justify-content: center; padding: 156px 72px 24px; }
  .hero-copy { max-width: 760px; padding-block: 44px; }
  .hero .display { font-size: clamp(76px, 15vw, 164px); }
  .hero .intro { max-width: 590px; margin: 28px 0 30px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }

  .statement h2 { margin-bottom: 18px; }
  .statement > p { max-width: 850px; margin: 0; color: var(--fg); font: 400 clamp(26px, 4vw, 44px)/1.25 var(--sans); letter-spacing: -.035em; }

  .projects { border-top: 1px solid var(--border); scroll-margin-top: 76px; }
  .projects > header { padding: 56px 72px 40px; }
  .project-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0; padding: 0; border-top: 1px solid var(--border); list-style: none; }
  .project-grid li { min-width: 0; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .project-grid li:nth-child(5n) { border-right: 0; }
  .project-grid a { display: flex; min-height: 154px; flex-direction: column; align-items: center; justify-content: center; gap: 18px; padding: 24px; background: transparent; color: var(--fg); text-align: center; text-decoration: none; }
  .project-grid a:hover { background: var(--hover); }
  .project-grid img { width: 52px; height: 52px; object-fit: contain; }
  .project-grid img[src$='wordle.png'] { filter: invert(1); }
  .project-grid strong { max-width: 100%; font: 600 14px/1.35 var(--sans); }

  @media (max-width: 800px) {
    .hero { padding: 120px 24px 24px; }
    .hero .display { font-size: clamp(70px, 24vw, 112px); }
    .statement > p { font-size: clamp(24px, 6vw, 36px); }
    .projects { scroll-margin-top: 68px; }
    .projects > header { padding: 48px 24px 32px; }
    .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .project-grid li:nth-child(5n) { border-right: 1px solid var(--border); }
    .project-grid li:nth-child(2n) { border-right: 0; }
  }

  @media (max-width: 560px) {
    .actions { flex-direction: column; }
    .project-grid a { min-height: 132px; padding: 20px; }
    .project-grid img { width: 44px; height: 44px; }
  }
</style>
