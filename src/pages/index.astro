---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleField from '../components/ParticleField.astro';
import ProjectArchiveLink from '../components/ProjectArchiveLink.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TechStack from '../components/TechStack.astro';
import { site } from '../data/site';
import { getProjects, projectPath } from '../lib/projects';

const projects = await getProjects();
const featuredProjects = projects.slice(0, 10);
---

<BaseLayout title="Aveek Saha — Design 01: Ledger" description={site.role} active="01">
  <div class="shell ledger">
    <ParticleField variant="network">
      <section class="hero" aria-labelledby="ledger-title">
        <div class="hero-copy">
          <h1 class="display" id="ledger-title">Aveek<br />Saha.</h1>
          <p class="intro">{site.role}</p>
          <div class="actions">
            <a class="button" href="#projects">Projects <span aria-hidden="true">↓</span></a>
            <a class="button secondary" href="mailto:aveek.s98@gmail.com">Contact Me</a>
          </div>
        </div>
      </section>
    </ParticleField>

    <section class="section projects" id="projects" aria-labelledby="projects-title">
      <div class="section-head">
        <h2 class="section-title" id="projects-title">Projects</h2>
      </div>
      <ol class="rule-list ledger-list">
        {featuredProjects.map((project, index) => (
          <li>
            <a href={projectPath(project)} aria-label={`${project.data.title} project details`}>
              <span class="count">{String(index + 1).padStart(2, '0')}</span>
              <img src={`/img/portfolio/${project.data.img}`} alt="" loading="lazy" />
              <strong>{project.data.title}</strong>
              <span>{project.data.category}</span>
              <time datetime={project.data.date.toISOString()}>{project.data['project-date']}</time>
              <i aria-hidden="true">↗</i>
            </a>
          </li>
        ))}
      </ol>
    </section>
    <ProjectArchiveLink />

    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="about-grid">
        <h2 class="section-title" id="about-title">Who am I?</h2>
        <div>
          <p class="intro">{site.about}</p>
        </div>
      </div>
      <div class="timeline">
        <div><p class="eyebrow">Education</p>{site.education.map((item) => <article><h3>{item.place}</h3><p>{item.detail}</p></article>)}</div>
        <div><p class="eyebrow">Past experience</p>{site.experience.map((item) => <article><h3>{item.place}</h3><p>{item.detail}</p></article>)}</div>
      </div>
    </section>
    <TechStack variant="ledger" />
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .hero { display: flex; min-height: 100svh; flex-direction: column; justify-content: center; padding: 156px 72px 24px; }
  .hero-copy { max-width: 760px; padding-block: 44px; }
  .hero .display { font-size: clamp(76px, 15vw, 164px); }
  .hero .intro { max-width: 590px; margin: 28px 0 30px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .section-head { margin-bottom: 54px; }
  .ledger-list a { display: grid; width: 100%; grid-template-columns: 34px 46px minmax(170px, 1.5fr) 1fr 110px 20px; align-items: center; gap: 18px; padding: 17px 0; color: var(--weak); font: 12px/1.4 var(--mono); text-align: left; text-decoration: none; }
  .ledger-list a:hover { background: var(--hover); color: var(--fg); }
  .ledger-list img { width: 42px; aspect-ratio: 1; padding: 6px; object-fit: contain; background: var(--surface); }
  .ledger-list strong { color: var(--fg); font-family: var(--sans); font-size: 16px; font-weight: 600; }
  .ledger-list time { font-size: 10px; }
  .ledger-list i { color: var(--fg); font-style: normal; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 68px; }
  .about-grid .intro { margin-top: 0; }
  .timeline { display: grid; grid-template-columns: 1fr 1fr; gap: 68px; margin-top: 72px; padding-top: 48px; border-top: 1px solid var(--border); }
  .timeline article { display: grid; grid-template-columns: 180px 1fr; gap: 24px; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .timeline h3, .timeline p { margin: 0; }
  .timeline h3 { color: var(--fg); font-size: 12px; }
  .timeline p { font: 14px/1.55 var(--sans); }
  @media (max-width: 800px) {
    .hero { padding: 120px 24px 24px; }
    .hero .display { font-size: clamp(70px, 24vw, 112px); }
    .section-head, .about-grid, .timeline { grid-template-columns: 1fr; gap: 34px; }
    .ledger-list a { grid-template-columns: 26px 40px 1fr 18px; gap: 12px; }
    .ledger-list a > span:nth-of-type(2), .ledger-list time { display: none; }
  }
  @media (max-width: 520px) { .timeline article { grid-template-columns: 1fr; gap: 5px; } }
</style>
