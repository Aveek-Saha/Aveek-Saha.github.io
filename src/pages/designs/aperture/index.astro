---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ParticleField from '../../../components/ParticleField.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { site } from '../../../data/site';
import { getProjects } from '../../../lib/projects';

const projects = await getProjects();
---

<BaseLayout title="Aveek Saha — Design 02: Aperture" description={site.role} active="02" projects={projects}>
  <div class="shell aperture">
    <ParticleField variant="drift">
      <section class="hero" aria-labelledby="aperture-title">
        <div class="coordinates"><span>42.3601° N</span><span>71.0589° W</span></div>
        <div class="frame">
          <span class="corner c1"></span><span class="corner c2"></span><span class="corner c3"></span><span class="corner c4"></span>
          <p class="eyebrow">Through the aperture</p>
          <h1 id="aperture-title">Ideas become<br /><em>working things.</em></h1>
          <p>{site.role}</p>
          <a href="#work">View the work <span aria-hidden="true">↘</span></a>
        </div>
        <div class="hero-index"><span>AS / PORTFOLIO</span><span>DESIGN 02 OF 05</span></div>
      </section>
    </ParticleField>

    <section class="statement section">
      <p class="eyebrow">Working thesis</p>
      <p>I like the seam between <b>systems</b> and <b>stories</b>—where code stops being abstract and starts becoming something people can use.</p>
    </section>

    <section class="work" id="work" aria-labelledby="aperture-projects">
      <header class="section">
        <p class="eyebrow">{projects.length} observations</p>
        <h2 class="section-title" id="aperture-projects">A visual archive of projects.</h2>
      </header>
      <div class="gallery">
        {projects.map((project, index) => (
          <button class:list={['tile', index % 7 === 0 && 'wide']} data-project={project.data['modal-id']} aria-label={`Open ${project.data.title} project details`}>
            <span class="visual"><img src={`/img/portfolio/${project.data.img}`} alt="" loading="lazy" /></span>
            <span class="caption"><i>{String(index + 1).padStart(2, '0')}</i><strong>{project.data.title}</strong><small>{project.data.category}</small><b aria-hidden="true">↗</b></span>
          </button>
        ))}
      </div>
    </section>

    <section class="section profile" id="about">
      <div class="profile-title"><p class="eyebrow">Behind the work</p><h2 class="section-title">Aveek Saha is a computer scientist and multidisciplinary builder.</h2></div>
      <div class="profile-copy"><p class="intro">{site.about}</p><a class="button" href="mailto:aveek.s98@gmail.com">Let’s make something</a></div>
      <div class="facts">
        <span>Based between</span><b>Boston / Bangalore</b><span>Focus areas</span><b>{site.disciplines.slice(0, 3).join(' / ')}</b>
      </div>
    </section>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .hero { display: grid; min-height: 100svh; grid-template-rows: auto 1fr auto; padding: 98px 44px 34px; }
  .coordinates, .hero-index { display: flex; justify-content: space-between; color: var(--weak); font-size: 10px; letter-spacing: .08em; }
  .frame { position: relative; width: min(780px, 88%); margin: auto; padding: clamp(44px, 8vw, 82px); text-align: center; }
  .corner { position: absolute; width: 44px; height: 44px; border-color: var(--border-strong); }
  .c1 { top: 0; left: 0; border-top: 1px solid; border-left: 1px solid; } .c2 { top: 0; right: 0; border-top: 1px solid; border-right: 1px solid; }
  .c3 { bottom: 0; left: 0; border-bottom: 1px solid; border-left: 1px solid; } .c4 { right: 0; bottom: 0; border-right: 1px solid; border-bottom: 1px solid; }
  .frame h1 { margin: 16px 0 24px; color: var(--fg); font: 600 clamp(48px, 8vw, 92px)/.98 var(--sans); letter-spacing: -.065em; }
  .frame h1 em { font-family: Georgia, serif; font-weight: 400; }
  .frame > p:not(.eyebrow) { max-width: 540px; margin: 0 auto 28px; font: 18px/1.65 var(--sans); }
  .frame a { font-size: 12px; font-weight: 600; }
  .statement > p:last-child { max-width: 850px; margin: 0; color: var(--fg); font: 400 clamp(30px, 5vw, 52px)/1.18 var(--sans); letter-spacing: -.04em; }
  .statement b { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 8px; text-underline-offset: -4px; }
  .work header { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--border); }
  .tile { min-width: 0; padding: 0; border: 0; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); background: transparent; color: var(--text); cursor: pointer; text-align: left; }
  .tile:nth-child(3n) { border-right: 0; }
  .visual { display: grid; aspect-ratio: 1.25; place-items: center; overflow: hidden; background: var(--surface); }
  .visual img { width: 35%; transition: transform .3s ease; }
  .tile:hover .visual img { transform: scale(1.12) rotate(-2deg); }
  .caption { display: grid; grid-template-columns: 24px 1fr auto; gap: 12px; align-items: center; padding: 18px; }
  .caption i { color: var(--weak); font: normal 10px var(--mono); }
  .caption strong { color: var(--fg); font: 600 14px var(--sans); }
  .caption small { grid-column: 2; color: var(--weak); font-size: 10px; }
  .caption b { grid-column: 3; grid-row: 1 / span 2; color: var(--fg); }
  .profile { display: grid; grid-template-columns: 1.1fr .9fr; gap: 72px; }
  .profile-copy .intro { margin: 0 0 28px; }
  .facts { grid-column: 1 / -1; display: grid; grid-template-columns: auto 1fr auto 1fr; gap: 12px 24px; padding-top: 40px; border-top: 1px solid var(--border); font-size: 11px; }
  .facts b { color: var(--fg); font-weight: 500; }
  @media (max-width: 800px) {
    .hero { padding: 90px 24px 28px; }
    .frame { width: 100%; padding: 52px 24px; }
    .gallery { grid-template-columns: repeat(2, 1fr); }
    .tile:nth-child(3n) { border-right: 1px solid var(--border); } .tile:nth-child(2n) { border-right: 0; }
    .profile { grid-template-columns: 1fr; gap: 28px; }
    .facts { grid-column: auto; grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) { .gallery { grid-template-columns: 1fr; } .tile, .tile:nth-child(3n) { border-right: 0; } .coordinates { visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { .visual img { transition: none; } }
</style>
