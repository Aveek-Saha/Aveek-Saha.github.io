---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ParticleField from '../../../components/ParticleField.astro';
import ProjectArchiveLink from '../../../components/ProjectArchiveLink.astro';
import ExperienceSection from '../../../components/ExperienceSection.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { site } from '../../../data/site';
import { getProjects, projectPath } from '../../../lib/projects';

const projects = await getProjects();
const featuredProjects = projects.slice(0, 10);
const grouped = Object.entries(Object.groupBy(featuredProjects, (project) => project.data.date.getFullYear().toString())).sort(([a], [b]) => Number(b) - Number(a));
---

<BaseLayout title="Aveek Saha — Design 05: Signal" description={site.role} active="05">
  <div class="shell signal">
    <ParticleField variant="orbit">
      <section class="hero" aria-labelledby="signal-title">
        <div class="reticle" aria-hidden="true"><span></span><span></span></div>
        <div class="hero-copy">
          <p class="eyebrow">{site.role}</p>
          <h1 id="signal-title">Aveek<br />Saha</h1>
          <div><a class="button" href="#transmissions">Projects</a><a class="text-link" href="mailto:aveek.s98@gmail.com">Contact Me ↗</a></div>
        </div>
      </section>
    </ParticleField>

    <section class="section manifesto">
      <h2>Who am I?</h2>
      <p>{site.about}</p>
    </section>

    <section class="transmissions" id="transmissions" aria-labelledby="transmissions-title">
      <header class="section"><h2 class="section-title" id="transmissions-title">Projects</h2></header>
      {grouped.map(([year, yearProjects]) => (
        <section class="year-group" aria-labelledby={`year-${year}`}>
          <div class="year"><span id={`year-${year}`}>{year}</span></div>
          <div class="signals-list">
            {yearProjects?.map((project, index) => (
              <a href={projectPath(project)} aria-label={`${project.data.title} project details`}>
                <span class="frequency">{year.slice(-2)}.{String(index + 1).padStart(2, '0')}</span>
                <span class="project-mark"><img src={`/img/portfolio/${project.data.img}`} alt="" loading="lazy" /></span>
                <span class="name"><strong>{project.data.title}</strong><small>{project.data.category}</small></span>
                <span class="wave" aria-hidden="true">━━━━━━━━╱╲━━━━╱╲━━</span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      ))}
      <ProjectArchiveLink />
    </section>

    <ExperienceSection />
    <section class="section contact" id="about">
      <div><h2 class="section-title">Contact Me</h2></div>
      <div class="contact-actions"><a class="button" href="mailto:aveek.s98@gmail.com">aveek.s98@gmail.com</a><a class="button secondary" href="/aveek_saha_resume.pdf">Download résumé</a></div>
      <ul>{site.disciplines.map((item) => <li><span>—</span>{item}</li>)}</ul>
    </section>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .signal { --accent-line: var(--accent); }
  .hero { display: flex; min-height: 100svh; align-items: flex-start; justify-content: center; padding: 94px 48px 32px; }
  .reticle { position: absolute; top: 50%; left: 50%; width: min(68vw, 680px); aspect-ratio: 1; transform: translate(-50%, -50%); border: 1px solid var(--border); border-radius: 50%; opacity: .6; }
  .reticle::before, .reticle::after { position: absolute; content: ''; background: var(--border); }
  .reticle::before { top: 50%; left: -10vw; width: calc(100% + 20vw); height: 1px; }
  .reticle::after { top: -10vw; left: 50%; width: 1px; height: calc(100% + 20vw); }
  .reticle span { position: absolute; inset: 17%; border: 1px dashed var(--border-strong); border-radius: 50%; }
  .reticle span:last-child { inset: 40%; border-style: solid; }
  .hero-copy { z-index: 2; align-self: center; max-width: 830px; padding: 40px 0; }
  .hero h1 { margin: 12px 0 26px; color: var(--fg); font: 650 clamp(56px, 9vw, 100px)/.96 var(--sans); letter-spacing: -.07em; }
  .hero-copy > div { display: flex; align-items: center; gap: 24px; margin-top: 30px; }
  .text-link { font-size: 12px; font-weight: 600; }
  .manifesto { display: grid; grid-template-columns: 1.5fr .5fr; gap: 72px; }
  .manifesto .eyebrow { grid-column: 1 / -1; }
  .manifesto h2 { margin: 0; color: var(--fg); font: 600 clamp(38px, 6vw, 64px)/1.06 var(--sans); letter-spacing: -.055em; }
  .manifesto h2 span { color: var(--weak); }
  .manifesto > p:last-child { align-self: end; margin: 0; font: 16px/1.7 var(--sans); }
  .transmissions > header { display: flex; align-items: end; justify-content: space-between; }
  .transmissions > header > p { max-width: 340px; font: 15px/1.6 var(--sans); }
  .year-group { display: grid; grid-template-columns: 180px 1fr; border-top: 1px solid var(--border); }
  .year { padding: 32px; border-right: 1px solid var(--border); }
  .year span { display: block; color: var(--fg); font: 600 34px var(--sans); letter-spacing: -.04em; }
  .signals-list a { display: grid; width: 100%; grid-template-columns: 52px 50px minmax(160px, 1fr) minmax(100px, .6fr) 18px; align-items: center; gap: 18px; padding: 14px 32px; border-bottom: 1px solid var(--border); background: transparent; color: var(--weak); font: 10px var(--mono); text-align: left; text-decoration: none; }
  .signals-list a:last-child { border-bottom: 0; }
  .signals-list a:hover { background: var(--accent-soft); color: var(--fg); }
  .project-mark { display: grid; width: 46px; aspect-ratio: 1; place-items: center; background: var(--surface); }
  .project-mark img { width: 62%; }
  .name strong, .name small { display: block; }
  .name strong { color: var(--fg); font: 600 15px var(--sans); }
  .name small { margin-top: 4px; color: var(--weak); font: 9px var(--mono); }
  .wave { overflow: hidden; color: var(--border-strong); letter-spacing: -2px; white-space: nowrap; }
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 54px; }
  .contact .intro { margin-bottom: 0; }
  .contact-actions { display: flex; align-items: end; justify-content: end; gap: 10px; }
  .contact ul { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; padding: 34px 0 0; border-top: 1px solid var(--border); gap: 16px 32px; list-style: none; }
  .contact li { color: var(--fg); font-size: 11px; }
  .contact li span { margin-right: 10px; color: var(--weak); }
  @media (max-width: 800px) {
    .hero { padding: 88px 24px 28px; }
    .hero h1 { font-size: clamp(52px, 16vw, 78px); }
    .manifesto, .contact { grid-template-columns: 1fr; gap: 32px; }
    .manifesto .eyebrow, .contact ul { grid-column: auto; }
    .year-group { grid-template-columns: 1fr; }
    .year { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px; border-right: 0; border-bottom: 1px solid var(--border); }
    .signals-list a { grid-template-columns: 44px 42px 1fr 16px; padding-inline: 24px; }
    .wave { display: none; }
    .contact-actions { justify-content: start; }
  }
  @media (max-width: 540px) { .hero-copy > div, .contact-actions { align-items: stretch; flex-direction: column; } .signal .text-link { align-self: center; } .signals-list a { grid-template-columns: 34px 1fr 16px; } .project-mark { display: none; } .contact ul { grid-template-columns: 1fr 1fr; } }
</style>
