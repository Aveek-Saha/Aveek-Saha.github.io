---
import type { Project } from '../lib/projects';

interface Props { projects: Project[]; }
const { projects } = Astro.props;
---

{projects.map((project) => (
  <dialog id={`project-${project.data['modal-id']}`} aria-labelledby={`project-title-${project.data['modal-id']}`}>
    <form method="dialog"><button class="dialog-close" aria-label="Close project">Close ×</button></form>
    <div class="dialog-grid">
      <div class="dialog-visual"><img src={`/img/portfolio/${project.data.img}`} alt="" /></div>
      <article>
        <p class="eyebrow">{project.data.category} · {project.data['project-date']}</p>
        <h2 id={`project-title-${project.data['modal-id']}`}>{project.data.title}</h2>
        {project.data.description && <div class="description" set:html={project.data.description} />}
      </article>
    </div>
  </dialog>
))}

<style is:global>
  dialog { width: min(880px, calc(100% - 32px)); max-height: calc(100svh - 32px); padding: 0; overflow: auto; border: 1px solid var(--border-strong); border-radius: 6px; background: var(--bg); color: var(--text); }
  dialog::backdrop { background: rgba(7,7,8,.76); backdrop-filter: blur(5px); }
  .dialog-close { position: sticky; z-index: 2; top: 14px; float: right; min-height: 38px; margin: 14px 14px -52px 0; padding: 0 13px; border: 1px solid var(--border-strong); border-radius: 4px; background: var(--surface); color: var(--fg); cursor: pointer; font: 12px var(--mono); }
  .dialog-grid { display: grid; grid-template-columns: minmax(240px, .85fr) 1.15fr; min-height: 520px; }
  .dialog-visual { display: grid; place-items: center; padding: 56px; border-right: 1px solid var(--border); background: var(--surface); }
  .dialog-visual img { width: min(230px, 100%); }
  .dialog-grid article { align-self: center; padding: 72px 56px; }
  .dialog-grid h2 { margin: 0 0 22px; color: var(--fg); font: 650 clamp(30px, 4vw, 46px)/1.05 var(--sans); letter-spacing: -.045em; }
  .description { font: 17px/1.7 var(--sans); }
  .description a { overflow-wrap: anywhere; }
  .description div { margin-top: 26px; color: var(--weak); font: 10px/1.5 var(--mono); }
  @media (max-width: 680px) {
    .dialog-grid { grid-template-columns: 1fr; }
    .dialog-visual { min-height: 260px; border-right: 0; border-bottom: 1px solid var(--border); }
    .dialog-visual img { width: 130px; }
    .dialog-grid article { padding: 44px 24px; }
  }
</style>
