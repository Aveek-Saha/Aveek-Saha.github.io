---
const { active } = Astro.props;
const designs = [
  ['01', 'Ledger', '/'],
  ['02', 'Aperture', '/designs/aperture/'],
  ['03', 'Index', '/designs/index/'],
  ['04', 'Field notes', '/designs/field-notes/'],
  ['05', 'Signal', '/designs/signal/'],
  ['06', 'Final', '/designs/final/'],
];
---

<header class="design-nav">
  <a class="brand" href="/" aria-label="Aveek Saha, home"><span aria-hidden="true">AS</span><b>Aveek Saha</b></a>
  <nav aria-label="Design concepts">
    {designs.map(([number, label, href]) => (
      <a href={href} aria-current={active === number ? 'page' : undefined}><span>{number}</span> {label}</a>
    ))}
  </nav>
</header>

<style>
  .design-nav { position: fixed; z-index: 50; top: 0; left: 50%; display: flex; width: min(var(--shell), 100%); min-height: 62px; align-items: center; gap: 28px; padding: 0 24px; transform: translateX(-50%); border: 1px solid var(--border); border-top: 0; background: var(--header); backdrop-filter: blur(14px); }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; white-space: nowrap; }
  .brand span { display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid var(--border-strong); font-size: 10px; }
  .brand b { font-size: 12px; font-weight: 600; }
  nav { display: flex; flex: 1; justify-content: center; gap: 2px; }
  nav a { padding: 9px 10px; color: var(--weak); font-size: 11px; text-decoration: none; }
  nav a span { margin-right: 3px; opacity: .6; }
  nav a:hover, nav a[aria-current='page'] { background: var(--hover); color: var(--fg); }
  nav a[aria-current='page'] { box-shadow: inset 0 -1px var(--fg); }
  @media (max-width: 800px) {
    .design-nav { min-height: 58px; padding: 0 14px; }
    .brand b { display: none; }
    nav { justify-content: flex-start; overflow-x: auto; }
    nav a { padding-inline: 9px; }
    nav a:not([aria-current='page']) { font-size: 0; }
    nav a span { font-size: 11px; }
  }
</style>
