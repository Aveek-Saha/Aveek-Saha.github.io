---
const { variant = 'network', label = 'Animated ASCII 3D geometry' } = Astro.props;
---

<div class={`particle-field shape-${variant}`} data-ascii-scene={variant}>
  <div class="ascii-scene" aria-hidden="true"></div>
  <div class="particle-content"><slot /></div>
  <button class="animation-toggle" type="button" data-animation-toggle>Stop animation</button>
  <span class="sr-only">{label}. Animation is decorative.</span>
</div>

<script>
  const fields = [...document.querySelectorAll<HTMLElement>('[data-ascii-scene]')];
  const pausePreference = 'portfolio-animation-paused';

  async function initialiseScenes() {
    try {
      const { initialiseAsciiScenes } = await import('../scripts/ascii-scenes');
      initialiseAsciiScenes(fields);
    } catch {
      fields.forEach((field) => {
        field.dataset.animationState = 'unsupported';
        const toggle = field.querySelector<HTMLButtonElement>('[data-animation-toggle]');
        if (toggle) toggle.hidden = true;
      });
    }
  }

  fields.forEach((field) => {
    field.dataset.animationState = 'loading';
    const toggle = field.querySelector<HTMLButtonElement>('[data-animation-toggle]');
    let paused = false;
    try {
      paused = localStorage.getItem(pausePreference) === 'true';
    } catch {
      // Use the default label when storage is unavailable.
    }
    if (toggle && paused) {
      toggle.textContent = 'Start animation';
      toggle.setAttribute('aria-pressed', 'true');
    }
  });

  const requestIdle = (window as unknown as {
    requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
  }).requestIdleCallback;

  function scheduleInitialisation() {
    if (requestIdle) {
      requestIdle.call(window, initialiseScenes, { timeout: 600 });
    } else {
      setTimeout(initialiseScenes, 1);
    }
  }

  if (document.readyState === 'complete') {
    scheduleInitialisation();
  } else {
    addEventListener('load', scheduleInitialisation, { once: true });
  }
</script>

<style>
  .particle-field { position: relative; min-height: 100svh; overflow: hidden; border-bottom: 1px solid var(--border); background: var(--bg); }
  .ascii-scene { position: absolute; inset: 0; overflow: hidden; opacity: .36; }
  .ascii-scene :global(.ascii-output) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .particle-content { position: relative; z-index: 1; min-height: inherit; pointer-events: none; }
  .particle-content :global(a), .particle-content :global(button) { pointer-events: auto; }
  .animation-toggle { position: absolute; z-index: 2; right: 20px; bottom: 80px; min-height: 42px; padding: 0 13px; border: 1px solid var(--border-strong); border-radius: 4px; background: rgba(7, 7, 8, .88); color: var(--fg); cursor: pointer; font: 600 11px/1 var(--mono); }
  .animation-toggle:hover { background: var(--hover); }
  .animation-toggle[aria-pressed='true'] { border-color: var(--fg); }
  @media (max-width: 600px) {
    .ascii-scene { opacity: .24; }
    .animation-toggle { right: 12px; bottom: 48px; min-height: 40px; }
  }
</style>
