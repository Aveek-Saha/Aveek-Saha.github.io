---
const { variant = 'network', label = 'Interactive particle field' } = Astro.props;
---

<div class={`particle-field particle-${variant}`} data-particles={variant}>
  <canvas aria-hidden="true"></canvas>
  <div class="particle-content"><slot /></div>
  <span class="sr-only">{label}. Animation is decorative.</span>
</div>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-particles]').forEach((field) => {
    const canvas = field.querySelector('canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const kind = field.dataset.particles || 'network';
    let width = 0;
    let height = 0;
    let frame = 0;
    let particles: { x: number; y: number; vx: number; vy: number; r: number; }[] = [];
    const pointer = { x: -1000, y: -1000 };
    const color = () => getComputedStyle(document.documentElement).getPropertyValue('--fg').trim();
    const resize = () => {
      const ratio = Math.min(devicePixelRatio, 2);
      width = field.clientWidth;
      height = field.clientHeight;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      const amount = Math.max(28, Math.min(78, Math.round(width * height / 15000)));
      particles = Array.from({ length: amount }, (_, i) => {
        const ring = kind === 'orbit';
        const angle = i / amount * Math.PI * 2;
        return {
          x: ring ? width / 2 + Math.cos(angle) * Math.min(width, height) * (.18 + Math.random() * .3) : Math.random() * width,
          y: ring ? height / 2 + Math.sin(angle) * Math.min(width, height) * (.18 + Math.random() * .3) : Math.random() * height,
          vx: (Math.random() - .5) * (kind === 'drift' ? .24 : .42),
          vy: (Math.random() - .5) * (kind === 'drift' ? .24 : .42),
          r: 1 + Math.random() * (kind === 'constellation' ? 1.8 : 1.2),
        };
      });
    };
    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = color();
      ctx.strokeStyle = color();
      particles.forEach((p, index) => {
        if (!reduceMotion.matches) { p.x += p.vx; p.y += p.vy; }
        if (p.x < -5) p.x = width + 5; if (p.x > width + 5) p.x = -5;
        if (p.y < -5) p.y = height + 5; if (p.y > height + 5) p.y = -5;
        const dx = pointer.x - p.x; const dy = pointer.y - p.y; const pointerDist = Math.hypot(dx, dy);
        if (pointerDist < 130 && !reduceMotion.matches) { p.x -= dx * .002; p.y -= dy * .002; }
        ctx.globalAlpha = kind === 'matrix' ? .42 : .62;
        if (kind === 'matrix') ctx.fillRect(Math.round(p.x / 12) * 12, Math.round(p.y / 12) * 12, 2, 2);
        else { ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill(); }
        particles.slice(index + 1).forEach((q) => {
          const distance = Math.hypot(p.x - q.x, p.y - q.y);
          const limit = kind === 'constellation' ? 125 : 92;
          if (distance < limit) {
            ctx.globalAlpha = (1 - distance / limit) * (kind === 'drift' ? .1 : .2);
            ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke();
          }
        });
      });
      ctx.globalAlpha = 1;
      if (!reduceMotion.matches) frame = requestAnimationFrame(draw);
    };
    field.addEventListener('pointermove', (event) => {
      const bounds = field.getBoundingClientRect(); pointer.x = event.clientX - bounds.left; pointer.y = event.clientY - bounds.top;
    });
    field.addEventListener('pointerleave', () => { pointer.x = -1000; pointer.y = -1000; });
    const observer = new ResizeObserver(() => { cancelAnimationFrame(frame); resize(); draw(); });
    observer.observe(field);
    reduceMotion.addEventListener('change', () => { cancelAnimationFrame(frame); draw(); });
  });
</script>

<style>
  .particle-field { position: relative; min-height: 100svh; overflow: hidden; border-bottom: 1px solid var(--border); background: var(--bg); }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .particle-content { position: relative; z-index: 1; min-height: inherit; pointer-events: none; }
  .particle-content :global(a), .particle-content :global(button) { pointer-events: auto; }
</style>
