---
import { site } from '../data/site';
---

<section class="experience-section" aria-label="Education and past experience">
  <div>
    <h2>Present</h2>
      {site.current.map((item) => (
        <article><h3>{item.place}</h3><p>{item.detail}</p></article>
      ))}
    <h2>Education</h2>
    {site.education.map((item) => (
      <article><h3>{item.place}</h3><p>{item.detail}</p></article>
    ))}
  </div>
  <div>
    <h2>Past experience</h2>
    {site.experience.map((item) => (
      <article><h3>{item.place}</h3><p>{item.detail}</p></article>
    ))}
  </div>
</section>

<style>
  .experience-section { display: grid; grid-template-columns: 1fr 1fr; gap: 68px; padding: 72px; border-top: 1px solid var(--border); }
  h2 { margin: 0 0 28px; color: var(--fg); font: 650 clamp(24px, 3vw, 34px)/1.2 var(--sans); letter-spacing: -.04em; }
  article { padding: 20px 0; border-top: 1px solid var(--border); }
  h3, p { margin: 0; }
  h3 { margin-bottom: 8px; color: var(--fg); font: 600 13px/1.45 var(--mono); }
  p { font: 15px/1.65 var(--sans); }
  @media (max-width: 800px) { .experience-section { grid-template-columns: 1fr; gap: 48px; padding: 56px 24px; } }
</style>
