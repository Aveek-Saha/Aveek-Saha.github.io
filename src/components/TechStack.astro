---
import {
  siAnsible,
  siArgo,
  siCilium,
  siDocker,
  siFlux,
  siGo,
  siGrafana,
  siHelm,
  siIstio,
  siKubernetes,
  siNvidia,
  siPrometheus,
  siPulumi,
  siPython,
  siRay,
  siTerraform,
  siVllm,
} from 'simple-icons';

type Variant = 'ledger' | 'aperture' | 'index' | 'notes' | 'signal';

const { variant = 'ledger', heading = 'Tech stack' } = Astro.props as { variant?: Variant; heading?: string };
const technologies = [
  siKubernetes,
  siGo,
  siPython,
  siVllm,
  siRay,
  siNvidia,
  siDocker,
  siHelm,
  siArgo,
  siFlux,
  siCilium,
  siIstio,
  siTerraform,
  siPulumi,
  siAnsible,
  siPrometheus,
  siGrafana,
];
---

<section class:list={['section', 'tech-stack', variant]} aria-labelledby={`tech-stack-${variant}`}>
  <h2 class="section-title" id={`tech-stack-${variant}`}>{heading}</h2>
  <ul>
    {technologies.map((technology) => (
      <li data-label={technology.title}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d={technology.path}></path>
        </svg>
        <span class="sr-only">{technology.title}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .tech-stack h2 { margin-bottom: 48px; }
  ul { display: flex; flex-wrap: wrap; align-items: center; margin: 0; padding: 8px 4px 28px; column-gap: clamp(30px, 4.7vw, 52px); row-gap: 48px; list-style: none; }
  li { position: relative; display: grid; width: 48px; height: 48px; flex: 0 0 auto; place-items: center; }
  li::after { position: absolute; z-index: 2; top: calc(100% + 9px); left: 50%; padding: 4px 7px; transform: translate(-50%, 3px); border-radius: 2px; background: var(--fg); color: var(--bg); content: attr(data-label); font: 600 10px/1.2 var(--mono); opacity: 0; pointer-events: none; transition: opacity .12s ease, transform .12s ease; white-space: nowrap; }
  li:hover::after { transform: translate(-50%, 0); opacity: 1; }
  svg { width: 46px; height: 46px; color: #fff; fill: currentColor; }
  .aperture ul { justify-content: center; }
  .aperture li, .aperture svg { width: 52px; height: 52px; }
  .notes ul { column-gap: clamp(34px, 5.3vw, 60px); }
  .notes li, .notes svg { width: 50px; height: 50px; }

  @media (max-width: 800px) {
    .tech-stack h2 { margin-bottom: 34px; }
    ul, .aperture ul, .notes ul { justify-content: flex-start; padding-inline: 2px; column-gap: clamp(25px, 8vw, 34px); row-gap: 38px; }
    li, .aperture li, .notes li, svg, .aperture svg, .notes svg { width: 36px; height: 36px; }
  }

  @media (prefers-reduced-motion: reduce) { li::after { transition: none; } }
</style>
