---
import {
  siAnsible,
  siArgo,
  siCilium,
  siDocker,
  siFlux,
  siGithubactions,
  siGo,
  siGrafana,
  siHelm,
  siIstio,
  siKubernetes,
  siOpentelemetry,
  siPrometheus,
  siPulumi,
  siPython,
  siTerraform,
} from 'simple-icons';

type Variant = 'ledger' | 'aperture' | 'index' | 'notes' | 'signal';

const { variant = 'ledger' } = Astro.props as { variant?: Variant };
const technologies = [
  siKubernetes,
  siGo,
  siPython,
  siDocker,
  siHelm,
  siArgo,
  siFlux,
  siCilium,
  siIstio,
  siTerraform,
  siPulumi,
  siAnsible,
  siGithubactions,
  siPrometheus,
  siGrafana,
  siOpentelemetry,
];
---

<section class:list={['section', 'tech-stack', variant]} aria-labelledby={`tech-stack-${variant}`}>
  <h2 class="section-title" id={`tech-stack-${variant}`}>Tech stack</h2>
  <ul>
    {technologies.map((technology) => (
      <li data-label={technology.title}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d={technology.path}></path>
        </svg>
        <span class="sr-only">{technology.title}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .tech-stack h2 { margin-bottom: 48px; }
  ul { display: grid; grid-template-columns: repeat(8, 1fr); margin: 0; padding: 0; border-top: 1px solid var(--border); border-left: 1px solid var(--border); list-style: none; }
  li { position: relative; display: grid; min-width: 0; min-height: 112px; place-items: center; padding: 16px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  li::after { position: absolute; z-index: 2; bottom: 7px; left: 50%; padding: 4px 7px; transform: translate(-50%, 3px); border-radius: 2px; background: var(--fg); color: var(--bg); content: attr(data-label); font: 600 10px/1.2 var(--mono); opacity: 0; pointer-events: none; transition: opacity .12s ease, transform .12s ease; white-space: nowrap; }
  li:hover::after { transform: translate(-50%, 0); opacity: 1; }
  li:nth-child(8n + 1)::after { left: 7px; transform: translateY(3px); }
  li:nth-child(8n + 1):hover::after { transform: none; }
  li:nth-child(8n)::after { right: 7px; left: auto; transform: translateY(3px); }
  li:nth-child(8n):hover::after { transform: none; }
  svg { width: 42px; height: 42px; color: #fff; fill: currentColor; }
  .aperture li { min-height: 124px; }
  .aperture svg { width: 48px; height: 48px; }
  .index ul { grid-template-columns: repeat(4, 1fr); }
  .index li { min-height: 96px; }
  .index li:nth-child(8n + 1)::after, .index li:nth-child(8n)::after { right: auto; left: 50%; transform: translate(-50%, 3px); }
  .index li:nth-child(8n + 1):hover::after, .index li:nth-child(8n):hover::after { transform: translate(-50%, 0); }
  .index li:nth-child(4n + 1)::after { left: 7px; transform: translateY(3px); }
  .index li:nth-child(4n + 1):hover::after { transform: none; }
  .index li:nth-child(4n)::after { right: 7px; left: auto; transform: translateY(3px); }
  .index li:nth-child(4n):hover::after { transform: none; }
  .notes li { min-height: 122px; }
  .notes svg { width: 46px; height: 46px; }

  @media (max-width: 800px) {
    .tech-stack h2 { margin-bottom: 34px; }
    ul, .index ul { grid-template-columns: repeat(4, 1fr); }
    li, .aperture li, .index li, .notes li { min-height: 88px; padding: 10px; }
    svg, .aperture svg, .notes svg { width: 34px; height: 34px; }
    li:nth-child(8n + 1)::after, li:nth-child(8n)::after { right: auto; left: 50%; transform: translate(-50%, 3px); }
    li:nth-child(8n + 1):hover::after, li:nth-child(8n):hover::after { transform: translate(-50%, 0); }
    li:nth-child(4n + 1)::after { left: 5px; transform: translateY(3px); }
    li:nth-child(4n + 1):hover::after { transform: none; }
    li:nth-child(4n)::after { right: 5px; left: auto; transform: translateY(3px); }
    li:nth-child(4n):hover::after { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) { li::after { transition: none; } }
</style>
